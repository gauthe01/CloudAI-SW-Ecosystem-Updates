# Cloud AI Software Ecosystem Updates
# Production template. Store real values in AWS Secrets Manager/SSM, not in git.

APP_ENV=production
APP_NAME="Cloud AI Software Ecosystem Updates"
APP_SLUG=cloud-ai-software-ecosystem-updates
APP_BASE_URL=https://cloud-ai-software-ecosystem-updates.example.com
API_BASE_URL=https://cloud-ai-software-ecosystem-updates.example.com/api
CORS_ORIGINS=https://cloud-ai-software-ecosystem-updates.example.com
LOG_LEVEL=INFO

DATABASE_URL=<from-secret-store>
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

AUTH_MODE=local
APP_SECRET_KEY=<from-secret-store>
SESSION_COOKIE_NAME=cloud_ai_software_ecosystem_updates_session
SESSION_TTL_DAYS=30
SESSION_SHORT_TTL_HOURS=12
SECURE_COOKIES=true
ALLOW_LOCAL_AUTH_IN_PROD=true
BOOTSTRAP_ADMIN_EMAIL=<bootstrap-admin-email>
BOOTSTRAP_ADMIN_PASSWORD=<from-secret-store>
BOOTSTRAP_ADMIN_DISPLAY_NAME=<bootstrap-admin-display-name>
LOCAL_USER_DEFAULT_PASSWORD=<from-secret-store>

AWS_REGION=us-east-1
S3_BUCKET=cloud-ai-software-ecosystem-updates-production
FILE_STORAGE_BACKEND=s3
LOCAL_UPLOAD_STORAGE_DIR=
MAX_UPLOAD_SIZE_MB=25
SQS_SOURCE_EVENTS_QUEUE_URL=<source-events-queue-url>
SQS_REPORT_JOBS_QUEUE_URL=<report-jobs-queue-url>
SQS_MEMORY_JOBS_QUEUE_URL=<memory-jobs-queue-url>

AI_PROVIDER=enterprise_openai_compatible
AI_BASE_URL=<enterprise-openai-compatible-base-url>
AI_MODEL_UPDATE_EXTRACTION=<approved-update-extraction-model>
AI_MODEL_REPORTING=<approved-reporting-model>
AI_API_KEY=<from-secret-store>
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_CA_BUNDLE=<container-path-to-approved-enterprise-ca-bundle>
AI_SOURCE_EVENT_EXTRACTION_MODE=infrastructure_only
AI_SOURCE_EVENT_MAX_OUTPUT_TOKENS=1200
RULEBOOK_DIR=app/agents/rulebooks/content

SLACK_SIGNING_SECRET=<from-secret-store>
SLACK_BOT_TOKEN=<from-secret-store>
JIRA_BASE_URL=<approved-jira-base-url>
JIRA_WEBHOOK_SECRET=<from-secret-store>
JIRA_SERVICE_TOKEN=<from-secret-store>
MICROSOFT_TENANT_ID=<from-secret-store>
MICROSOFT_CLIENT_ID=<from-secret-store>
MICROSOFT_CLIENT_SECRET=<from-secret-store>
CONFLUENCE_BASE_URL=<approved-confluence-base-url>
CONFLUENCE_TOKEN=<from-secret-store>
GITHUB_WEBHOOK_SECRET=<from-secret-store>
GITHUB_APP_ID=<from-secret-store>
GITHUB_PRIVATE_KEY=<from-secret-store>
