# Cloud AI Software Ecosystem Updates
# Copy to .env.local for local development when Feature 01 introduces runtime code.

APP_ENV=local
APP_NAME="Cloud AI Software Ecosystem Updates"
APP_SLUG=cloud-ai-software-ecosystem-updates
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cloud_ai_software_ecosystem_updates

# Auth
AUTH_MODE=local
APP_SECRET_KEY=change-me-in-local-only
SESSION_COOKIE_NAME=cloud_ai_software_ecosystem_updates_session
SESSION_SHORT_TTL_HOURS=12
SECURE_COOKIES=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-local-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Admin
LOCAL_USER_DEFAULT_PASSWORD=replace-with-local-user-default-password

# AWS-compatible local placeholders
AWS_REGION=us-east-1
S3_BUCKET=cloud-ai-software-ecosystem-updates-local
FILE_STORAGE_BACKEND=local
LOCAL_UPLOAD_STORAGE_DIR=var/uploads
MAX_UPLOAD_SIZE_MB=25
SQS_SOURCE_EVENTS_QUEUE_URL=
SQS_REPORT_JOBS_QUEUE_URL=
SQS_MEMORY_JOBS_QUEUE_URL=

# Integration secrets are intentionally blank here.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
JIRA_BASE_URL=
JIRA_WEBHOOK_SECRET=
JIRA_SERVICE_TOKEN=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
