AI_API_KEY=
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_CA_BUNDLE=/app/certs/ARM-Enterprise-PKI-Root-CA.pem
AI_SOURCE_EVENT_EXTRACTION_MODE=infrastructure_only
